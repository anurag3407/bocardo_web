{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bocardo-web",
  "account_id": "7e6fb4a6c65fd3d858f77de6a0399d3f",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "bocardo.in/*",
      "zone_name": "bocardo.in"
    },
    {
      "pattern": "www.bocardo.in/*",
      "zone_name": "bocardo.in"
    }
  ],
  "workers_dev": true
}
